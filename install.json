{
  "run": [
    {
      "method": "log",
      "params": {
        "raw": "Installing Python dependencies..."
      }
    },
    {
      "method": "shell.run",
      "params": {
        "message": "uv pip install -r requirements.txt",
        "venv": "env",
        "path": "."
      }
    },
    {
      "method": "log",
      "params": {
        "raw": "Installation complete!"
      }
    }
  ]
}
