{
  "daemon": true,
  "run": [
    {
      "method": "log",
      "params": {
        "raw": "Starting Virtual Model Emulator..."
      }
    },
    {
      "method": "shell.run",
      "params": {
        "message": "pip install -r requirements.txt",
        "venv": "env",
        "path": "."
      }
    },
    {
      "method": "shell.run",
      "params": {
        "message": "python -m server.main",
        "venv": "env",
        "on": [
          {
            "event": "/(http:\\/\\/localhost:[0-9]+\\/config\\.html)/",
            "done": true
          }
        ]
      }
    },
    {
      "method": "local.set",
      "params": {
        "url": "{{input.event[1]}}"
      }
    },
    {
      "method": "log",
      "params": {
        "raw": "UI ready at {{input.event[1]}}"
      }
    }
  ]
}
