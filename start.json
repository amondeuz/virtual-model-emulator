{
  "daemon": true,
  "run": [
    {
      "method": "log",
      "params": {
        "raw": "Starting Virtual Model Emulator..."
      }
    },
    {
      "method": "shell.run",
      "params": {
        "message": ".\\env\\Scripts\\python.exe -m server.main",
        "path": ".",
        "on": [
          {
            "event": "/(http:\\/\\/localhost:11434\\/config\\.html)/",
            "done": true
          }
        ]
      }
    },
    {
      "method": "local.set",
      "params": {
        "url": "{{input.event[1]}}"
      }
    },
    {
      "method": "log",
      "params": {
        "raw": "UI ready at {{input.event[1]}}"
      }
    }
  ]
}
